        {
          "info": {
            "name": "Create Customer Account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v2/customers"
          },
          "docs": "Prior to an order being placed, a Reseller creates an account for a Customer and the marketplace calls Create Customer Account. The customer resource is returned with link to Get Customer Account Details"
        },
        {
          "info": {
            "name": "Get Customer Account Details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v2/customers/:customer-id",
            "params": [
              {
                "name": "customer-id",
                "value": "",
                "type": "path",
                "description": "customer-id"
              }
            ]
          },
          "docs": "Finds specified customer account by account ID."
        },
        {
          "info": {
            "name": "Update Customer Account",
